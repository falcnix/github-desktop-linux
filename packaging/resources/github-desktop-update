#!/bin/sh
# Check for a newer GitHub Desktop package and install it right away,
# downloading it in the foreground if needed. Also forgets a version whose
# password prompt was dismissed earlier, so it is offered again.
#
#   github-desktop-update           install a newer package now
#   github-desktop-update --check   only report whether one is available
set -u
rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/github-desktop-linux/skipped-version"
here="$(dirname "$(readlink -f "$0")")"
if [ "${1:-}" = "--check" ]; then
  exec "$here/update-check" --check
fi
exec "$here/update-check" --now
