#!/bin/bash
# Self-update for the unofficial GitHub Desktop .deb.
#
# Looks up the newest published release of falcnix/github-desktop-linux. When
# its package is newer than the installed one:
#
#   * if that package has already been downloaded and its SHA-256 verified,
#     install it now (polkit password prompt via pkexec) so the launcher starts
#     the new version;
#   * otherwise start downloading it in the background and return at once, so
#     the app opens without waiting. The download resumes across restarts and
#     the update is installed the next time the app starts.
#
# Called by the github-desktop launcher on every plain start.
#
#   update-check            the startup behaviour described above
#   update-check --check    only report: exit 0 = up to date, 10 = update
#                           available, anything else = could not check
#   update-check --now      download in the foreground and install right away
#                           (what github-desktop-update runs)
#   update-check --download internal: the background download
#
# Environment:
#   GITHUB_DESKTOP_UPDATE_REPO       owner/repo to check (default falcnix/github-desktop-linux)
#   GITHUB_DESKTOP_UPDATE_API        override the releases/latest URL (testing)
#   GITHUB_DESKTOP_INSTALLED_VERSION override the installed Debian version (testing)
#
# A version whose password prompt the user dismissed is remembered in
# $XDG_CONFIG_HOME/github-desktop-linux/skipped-version and not offered again
# until an even newer one appears; github-desktop-update clears that.

set -uo pipefail

REPO="${GITHUB_DESKTOP_UPDATE_REPO:-falcnix/github-desktop-linux}"
PACKAGE="github-desktop"
API="${GITHUB_DESKTOP_UPDATE_API:-https://api.github.com/repos/${REPO}/releases/latest}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/github-desktop-linux"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/github-desktop-linux"
SELF="$(readlink -f "$0")"

MODE=startup
case "${1:-}" in
  --check) MODE=check ;;
  --now) MODE=now ;;
  --download) MODE=download ;;
  '') ;;
  *) echo "usage: update-check [--check|--now]" >&2; exit 2 ;;
esac

log() { printf 'github-desktop update: %s\n' "$*" >&2; }

notify() {
  # $1 summary, $2 body. Best effort: notify-send is only recommended.
  if command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name="GitHub Desktop" --icon=github-desktop "$1" "$2" 2>/dev/null || :
  fi
  log "$1: $2"
}

need() { command -v "$1" >/dev/null 2>&1; }

if ! need curl || ! need dpkg; then
  log "curl or dpkg not available; skipping"
  exit 2
fi

# --- What is installed? ------------------------------------------------------
installed="${GITHUB_DESKTOP_INSTALLED_VERSION:-}"
if [ -z "$installed" ]; then
  installed="$(dpkg-query -W -f='${Version}' "$PACKAGE" 2>/dev/null || true)"
fi
if [ -z "$installed" ]; then
  log "package $PACKAGE is not installed via dpkg; skipping"
  exit 2
fi

# --- What is the newest release? ---------------------------------------------
# releases/latest never returns drafts or pre-releases. -q ignores ~/.curlrc,
# so a user's curl settings cannot change what the API returns.
release_json="$(curl -q -fsSL --connect-timeout 5 --max-time 10 \
  -H 'Accept: application/vnd.github+json' "$API" 2>/dev/null)" || {
  log "could not reach the releases API; skipping"
  exit 2
}

# One "key": value pair per line, whether the API pretty-printed or not.
# Release asset URLs and tags never contain commas.
pairs="$(printf '%s' "$release_json" | tr ',' '\n')"
tag="$(sed -n 's/.*"tag_name":[[:space:]]*"\([^"]*\)".*/\1/p' <<<"$pairs" | head -n 1)"
deb_url="$(sed -n 's/.*"browser_download_url":[[:space:]]*"\([^"]*_amd64\.deb\)".*/\1/p' <<<"$pairs" | head -n 1)"
sum_url="$(sed -n 's/.*"browser_download_url":[[:space:]]*"\([^"]*_amd64\.deb\.sha256\)".*/\1/p' <<<"$pairs" | head -n 1)"

if [ -z "$tag" ] || [ -z "$deb_url" ] || [ -z "$sum_url" ]; then
  log "latest release has no .deb asset; skipping"
  exit 2
fi

# Release tags are v<app version>[-deb<revision>], e.g. v3.7.0, v3.6.6-beta1,
# v3.6.5-deb2. The Debian version is <app version with - as ~>-<revision>.
ver="${tag#v}"
revision=1
case "$ver" in
  *-deb[0-9]*) revision="${ver##*-deb}"; ver="${ver%-deb*}" ;;
esac
# The backslash matters: bash tilde-expands an unquoted ~ in the replacement.
latest="${ver//-/\~}-${revision}"

if ! dpkg --compare-versions "$latest" gt "$installed"; then
  log "installed $installed is up to date (latest $latest)"
  # Leftovers from an update installed some other way are no longer needed.
  rm -f "$CACHE_DIR"/github-desktop_*_amd64.deb "$CACHE_DIR"/github-desktop_*_amd64.deb.* 2>/dev/null
  exit 0
fi

log "update available: installed $installed, latest $latest ($tag)"
[ "$MODE" = check ] && exit 10

if [ "$MODE" = startup ]; then
  skipped="$(cat "$CONFIG_DIR/skipped-version" 2>/dev/null || true)"
  if [ "$skipped" = "$latest" ]; then
    log "version $latest was declined earlier; not asking again (run github-desktop-update)"
    exit 0
  fi
fi

if ! need pkexec || ! need apt-get; then
  notify "GitHub Desktop $ver is available" \
    "Download it from https://github.com/${REPO}/releases/latest"
  exit 0
fi

mkdir -p "$CACHE_DIR" "$CONFIG_DIR"
deb_name="$(basename "$deb_url")"
deb_file="$CACHE_DIR/$deb_name"         # only ever a complete, verified package
part_file="$deb_file.part"              # an in-progress download
sum_file="$deb_file.sha256"

# --- One updater at a time ---------------------------------------------------
# A second launch while a download or install is running just starts the app.
# The background download inherits this lock from the run that started it.
if [ "${GITHUB_DESKTOP_UPDATE_LOCK_HELD:-0}" != "1" ] && need flock; then
  exec 9>"$CACHE_DIR/.lock"
  if ! flock -n 9; then
    log "another update is already in progress; skipping"
    exit 0
  fi
fi

# Packages for other versions are never needed again.
for f in "$CACHE_DIR"/github-desktop_*_amd64.deb "$CACHE_DIR"/github-desktop_*_amd64.deb.*; do
  [ -e "$f" ] || continue
  case "$f" in "$deb_file"|"$part_file"|"$sum_file") ;; *) rm -f "$f" ;; esac
done

verified() {
  # True when $1 matches the published checksum.
  local expected actual
  [ -s "$1" ] && [ -s "$sum_file" ] || return 1
  expected="$(cut -d' ' -f1 "$sum_file")"
  actual="$(sha256sum "$1" | cut -d' ' -f1)"
  [ -n "$expected" ] && [ "$expected" = "$actual" ]
}

download() {
  # Fetch the checksum, then the package into $part_file (resuming whatever is
  # already there), and move it into place only once it verifies. A stalled
  # transfer gives up after a minute below 1 KB/s; the next start resumes it.
  local progress=-s
  [ "$MODE" = now ] && [ -t 2 ] && progress=--progress-bar
  curl -q -fSL -s --connect-timeout 20 --max-time 60 --retry 2 -o "$sum_file" "$sum_url" || return 1
  curl -q -fSL $progress --connect-timeout 20 --speed-limit 1024 --speed-time 60 \
    --retry 2 -C - -o "$part_file" "$deb_url" || return 1
  if verified "$part_file"; then
    mv -f "$part_file" "$deb_file"
    return 0
  fi
  log "checksum mismatch for $deb_name; discarding the download"
  rm -f "$part_file"
  return 1
}

install_now() {
  local status=0
  notify "Installing GitHub Desktop $ver" "You will be asked for your password."
  # --no-install-recommends keeps this from pulling in new optional packages
  # without asking; apt still resolves hard dependencies.
  pkexec apt-get install -y --no-install-recommends "$deb_file" || status=$?
  if [ "$status" -eq 0 ]; then
    rm -f "$deb_file" "$sum_file" "$CONFIG_DIR/skipped-version"
    if [ "$MODE" = startup ]; then
      notify "GitHub Desktop updated" "Version $ver is installed and is starting now."
    else
      notify "GitHub Desktop updated" "Version $ver is installed. Restart GitHub Desktop if it is open."
    fi
    return 0
  fi
  case "$status" in
    126)
      # The user dismissed the password dialog: respect that for this version.
      printf '%s\n' "$latest" > "$CONFIG_DIR/skipped-version"
      notify "GitHub Desktop update skipped" \
        "Version $ver will not be offered again. Run 'github-desktop-update' to install it later." ;;
    127)
      # Not authorised, wrong password, or no polkit agent: not a decision by
      # the user, so offer it again next time. The download is kept.
      notify "GitHub Desktop update not installed" \
        "Could not get administrator rights. Run 'github-desktop-update' in a terminal to install $ver." ;;
    *)
      notify "GitHub Desktop update failed" \
        "apt-get exited with status $status. It will be tried again next time." ;;
  esac
  return 1
}

case "$MODE" in
  startup)
    if verified "$deb_file"; then
      install_now
      exit $?
    fi
    rm -f "$deb_file"
    notify "Downloading GitHub Desktop $ver" \
      "It will be installed the next time you start GitHub Desktop."
    # Detached from the launcher and the terminal; the lock (fd 9) goes with it.
    GITHUB_DESKTOP_UPDATE_LOCK_HELD=1 setsid nohup "$SELF" --download \
      </dev/null >>"$CACHE_DIR/update.log" 2>&1 &
    exit 0
    ;;
  download)
    if download; then
      notify "GitHub Desktop $ver is ready" \
        "It will be installed the next time you start GitHub Desktop."
      exit 0
    fi
    log "download of $tag did not finish; it will resume next time"
    exit 1
    ;;
  now)
    if ! verified "$deb_file"; then
      rm -f "$deb_file"
      log "downloading $deb_name"
      if ! download; then
        notify "GitHub Desktop update failed" "Could not download $tag. Try again later."
        exit 1
      fi
    fi
    install_now
    exit $?
    ;;
esac
